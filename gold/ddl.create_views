--=======================================================
--Create view gold.dim_entity_master
--=======================================================
Drop view if exists gold.dim_entity_master;
Create View gold.dim_entity_master As
Select 
	entity,
	vertical,
	business_unit,
	entity_code,
	location_code as location,
	lob as line_of_business,
	decision_key as id_key
From silver.entity_master

--=======================================================
--Create view gold.dim_top150
--=======================================================
Drop view if exists gold.dim_top150;
Create View gold.dim_top150 as
select 
	top150_name as customer_name,
	account_name,
	customer_code,
	customer_name as oracle_customer_name	
From silver.top150_mapping

--=======================================================
--Create view gold.fact_revenue
--=======================================================
Drop View If Exists gold.fact_revenue;
Create View gold.fact_revenue As
Select 
	e.Entity as entity,
	e.Vertical as vertical,
	e.Business_unit as BU,
	e.Entity_code as entity_code,
	e.LOB as LOB,
	r.customer_number as customer_code,
	r.customer_name as oracle_customer_name,
	r.transaction_type as transaction_type,
	r.amount_accounted_currency as amount,
	r.accounting_date as date,
	r.account_description as account_description,
	r.analysis_description as analysis_description,
	r.decision_key as id_key,
	Case 
		When t150.account_name IS NULL Then 'No'
		Else 'Yes'
	End Top150_mapping
From silver.revenue_gl r
Left Join silver.entity_master e
on r.decision_key = e.decision_key
Left Join silver.top150_mapping t150
on r.customer_number = t150.customer_code



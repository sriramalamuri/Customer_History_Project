--=======================================================
--Create a table for entity master with details like
--Entity, BU, Location and LOB
--=======================================================

Create Table bronze.entity_master(
Entity varchar(50),
Vertical varchar(50),
Business_unit varchar(50),
Entity_code Int,
Location_code varchar(50),
LOB varchar(50),
Decision_combination varchar(50),
Decision_key Bigint
)

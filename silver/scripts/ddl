--===========================================================
--Creating table silver.entity_master
--===========================================================
DO $$
BEGIN
    IF to_regclass('silver.entity_master') IS NOT NULL THEN
        DROP TABLE silver.entity_master;
    END IF;
END $$;
Create table silver.entity_master(
Entity varchar(50),
Vertical varchar(50),
Business_unit varchar(50),
Entity_code Int,
Location_code varchar(50),
LOB varchar(50),
Decision_combination varchar(50),
Decision_key Bigint
)

--===========================================================
--Creating table silver.revenue_gl
--===========================================================
DO $$
BEGIN
    IF to_regclass('silver.revenue_gl') IS NOT NULL THEN
        DROP TABLE silver.revenue_gl;
    END IF;
END $$;
Create table silver.revenue_gl(
Code_Combination text,
Journal_Batch text,
Journal_Name text,
Source_Doc text,
Transaction_Type text,
Transaction_Source text,
Transaction_ID text,
Project_Number text,
Contract_Number text,
Amount_Accounted_Currency text,
Amount_Entered_Currency text,
Entered_Currency text,
Tax_Name text,
Tax_Rate text,
Tax_Jurisdiction_Code text,
Accounting_Date varchar(50),
PO_Number text,
Line_Description text,
Customer_Number text,
Customer_Name text,
Invoice_AP_AR text,
Invoice_Date varchar(50),
Payment_Receipt_Number_Asset_Number text,
From_Location text,
To_Location text,
Incoterms text,
Receipt_Number text,
Payment_Date text,
Account_Description text,
Analysis_Description text,
Posted_Date varchar(50),
Shipment_ID text
)


--CREATE SCHEMA PLATINUM

Create Schema platinum

--CREATE VIEW platinum.txn_normalized

Drop view if exists platinum.txn_normalized;
Create view platinum.txn_normalized as
Select
	*,
	Extract (Month from date) revenue_month,
	Extract (Quarter from date) revenue_qtr,
	Case
		When transaction_type IN ('Sales Invoices','Purchase Invoices','Deliver') Then 'clean_revenue'
		When transaction_type IN ('Accrual', 'Cargoes Cost Reclass','Cargoes Revenue Accrual') Then 'accrual'
		When transaction_type IN ('Adjustment','Allocations','Profit Share Adjustment') Then 'adjustment_revenue'
		When transaction_type = 'Credit Memos' Then 'credit_memos'
		When transaction_type = 'Debit Memos' Then 'debit_memos'
		Else 'manual'
	End norm_transaction_type,
	Case 
		When top150_mapping = 'Yes' Then 1
		Else 0
	End top150_flag,
	Case
		When transaction_type IN ('Sales Invoices','Purchase Invoices','Deliver') Then 1
		Else 0
	End is_clean_revenue,
	Case
		When transaction_type IN ('Adjustment','Allocations','Profit Share Adjustment') Then 1
		Else 0
	End is_adjustment_revenue,
	Case
		When transaction_type = 'Credit Memos' Then 1
		Else 0
	End is_credit_memo,
	Case
		When transaction_type = 'Debit Memos' Then 1
		Else 0
	End is_debit_memo,
	Case
		When transaction_type IN ('Accrual', 'Cargoes Cost Reclass','Cargoes Revenue Accrual') Then 1
		Else 0
	End is_accrual,
		Case
		When transaction_type IN ('Manual','Miscellaneous','Other','Receipts',Null) Then 1
		Else 0
	End is_manual,
	Extract(Day from date) day_of_month,
	Case
		When Extract(Day from date) > 25 Then 1
		Else 0
	End close_window_flag
From gold.fact_revenue

--CREATE VIEW platinum.customer_month_base
Drop View If Exists platinum.customer_month_base;
Create View platinum.customer_month_base As
With cte_1 As(
	Select
		revenue_month,
		customer_code,
		Case
			When is_clean_revenue = 1 Then Sum(amount)
			Else 0
		End clean_revenue_amount,
		Case
			When is_credit_memo = 1 Then Sum(amount)
			Else 0
		End credit_memo_amount,
		Case
			When is_debit_memo = 1 Then Sum(amount)
			Else 0
		End debit_memo_amount,	
		Case
			When is_accrual = 1 Then Sum(amount)
			Else 0
		End accrual_amount,
		Case
			When is_adjustment_revenue = 1 Then Sum(amount)
			Else 0
		End adjustment_revenue_amount,
		Case
			When is_manual = 1 Then Sum(amount)
			Else 0
		End manual_amount,
		Count (Distinct Entity) entity_footprint,
		Count (Distinct vertical) vertical_footprint,
		Count (Distinct bu) bu_footprint,
		Count (Distinct lob) lob_footprint
	From platinum.txn_normalized
	Group by 
	customer_code, 
	revenue_month,
	is_clean_revenue,
	is_credit_memo,
	is_debit_memo,
	is_accrual,
	is_adjustment_revenue,
	is_manual,
	Entity,
	vertical,
	bu,
	lob	
	Order by revenue_month
)
Select 
	revenue_month,
	customer_code,
	Sum(clean_revenue_amount) clean_revenue_amount,
	Sum(credit_memo_amount) credit_memo_amount,
	Sum(debit_memo_amount) debit_memo_amount,
	Sum(accrual_amount) accrual_amount,
	Sum(adjustment_revenue_amount) adjustment_revenue_amount,
	Sum(manual_amount) manual_amount,
	Count(Distinct entity_footprint) entity_footprint,
	Count(Distinct vertical_footprint) vertical_footprint,
	Count(Distinct bu_footprint) bu_footprint,
	Count(Distinct lob_footprint) lob_footprint
From cte_1
Group by
	revenue_month,
	customer_code
Order by 
	revenue_month

--CREATE VIEW platinum.segment_month_base
Drop View If Exists platinum.segment_month_base;
Create View platinum.segment_month_base as
With cte_2 As(
	Select
		revenue_month,
		entity,
		vertical,
		bu,
		lob,
		customer_code,
		Sum(amount) amount,
		Case
			When is_clean_revenue = 1 Then Sum(amount)
			Else 0
		End clean_revenue_amount,
		Case
			When is_credit_memo = 1 Then Sum(amount)
			Else 0
		End credit_memo_amount,
		Case
			When is_debit_memo = 1 Then Sum(amount)
			Else 0
		End debit_memo_amount,	
		Case
			When is_accrual = 1 Then Sum(amount)
			Else 0
		End accrual_amount,
		Case
			When is_adjustment_revenue = 1 Then Sum(amount)
			Else 0
		End adjustment_revenue_amount,
		Case
			When is_manual = 1 Then Sum(amount)
			Else 0
		End manual_amount
	From platinum.txn_normalized
	Group by  
	revenue_month,
	entity,
	vertical,
	bu,
	lob,
	customer_code,
	amount,
	is_clean_revenue,
	is_credit_memo,
	is_debit_memo,
	is_accrual,
	is_adjustment_revenue,
	is_manual
	Order by revenue_month
)
Select
	revenue_month,
	entity,
	vertical,
	bu,
	lob,
	Count(customer_code) customer_count,
	Sum(amount) total_revenue,
	Sum(clean_revenue_amount) clean_revenue_amount,
	Sum(credit_memo_amount) credit_memo_amount,
	Sum(debit_memo_amount) debit_memo_amount,
	Sum(accrual_amount) accrual_amount,
	Sum(adjustment_revenue_amount) adjustment_revenue_amount,
	Sum(manual_amount) manual_amount
From cte_2
Group by
	revenue_month,
	entity,
	vertical,
	bu,
	lob
Order by
	revenue_month
	
--CREATE VIEW platinum.period_reference
With cte_1 as(
Select
	date_trunc('month', date)::date as month_start
From platinum.txn_normalized
Group by
date
),
cte_2 as(
Select
	month_start,
	row_number() over() month_rank,
	Extract(quarter from month_start) current_qtr,
	Extract(year from month_start) current_yr		
From cte_1
Group by 
	month_start
Order by month_start desc
)
Select
	month_start,
	row_number() over() month_rank,
	current_yr || '-Q' || current_qtr quarter_label,
	Case
		When month_rank = 1 Then 1
		Else 0
	End is_latest_closed_month,
	Case 
		When month_rank = 2 Then 1
		Else 0
	End is_prior_month,
	Case
		When month_rank >=1 and month_rank <= 3 Then 1
		Else 0
	End is_trailing_3m,
	Case
		When month_rank >=4 and month_rank <= 6 Then 1
		Else 0
	End is_prior_3m,
	Case
		When month_rank >=1 and month_rank <= 12 Then 1
		Else 0
	End is_trailing_12m,
	Case 
		When month_rank >= 13 and month_rank <=24 Then 1
		Else 0
	End is_prior_12m
From cte_2
